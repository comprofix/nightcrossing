//kage:unit pixels

package main

// From is the brightness where the glow starts (0–1).
var From float

// Fragment keeps the colour of what is brighter than From, faded by how
// far over it is, for the glow to spread. Brightness is luma, so lamps and
// headlights glow but a deep blue does not.
func Fragment(dst vec4, src vec2, color vec4) vec4 {
	s := imageSrc0UnsafeAt(src)
	l := dot(s.rgb, vec3(0.299, 0.587, 0.114))
	return vec4(s.rgb*max(l-From, 0)/(1-From), s.a)
}
